def cmd_html(a):
    require_dir()
    if not a.no_pull:
        pull()
    out = pathlib.Path(a.outdir)
    out.mkdir(parents=True, exist_ok=True)
    ps = pages()
    nav = " ".join(f'<a href="{html.escape(p)}.html">{html.escape(p)}</a>' for p in ps)

    def shell(title, body):
        return (f"<!doctype html><html><head><meta charset=utf-8>"
                f"<meta name=viewport content='width=device-width,initial-scale=1'>"
                f"<title>{html.escape(title)}</title><style>{CSS}</style></head>"
                f"<body><div class=wrap>{body}</div></body></html>")

    rows = []
    for name in ps:
        summaries, frags = fragments(name)
        allf = summaries + frags
        authors = sorted({m.get("agent", "?") for _, m, _ in allf})
        last = (frags[-1][1] if frags else allf[-1][1]).get("ts", "-")
        rows.append(f"<tr><td><a href='{html.escape(name)}.html'>{html.escape(name)}</a></td>"
                    f"<td>{len(allf)}</td><td>{html.escape(', '.join(authors))}</td>"
                    f"<td>{html.escape(last)}</td></tr>")

        blocks = []
        for _, m, body in summaries:
            blocks.append(
                f"<div class='frag digest'><h3>Digest — {html.escape(m.get('agent','?'))}</h3>"
                f"<div class=meta>{html.escape(m.get('ts','-'))}</div>"
                f"<pre>{html.escape(body)}</pre></div>")
        for _, m, body in frags:
            t = m.get("title") or "(untitled)"
            refs = f" · refs: {html.escape(m['refs'])}" if m.get("refs") else ""
            blocks.append(
                f"<div class=frag><h3>{html.escape(t)}</h3>"
                f"<div class=meta>{html.escape(m.get('agent','?'))} · "
                f"{html.escape(m.get('ts','-'))}{refs}</div>"
                f"<pre>{html.escape(body)}</pre></div>")
        (out / f"{name}.html").write_text(shell(
            f"wiki/{name}",
            f"<h1>{html.escape(name)}</h1>"
            f"<p class=mut><a href='index.html'>&larr; index</a> · "
            f"{len(allf)} fragments</p><nav>{nav}</nav>" + "".join(blocks)))

    (out / "index.html").write_text(shell(
        "collab wiki",
        "<h1>collab wiki</h1>"
        f"<p class=mut>{len(ps)} pages · rendered {html.escape(now())} · "
        "source: collab_v0.git <code>wiki/</code></p>"
        "<table><tr><th>page</th><th>frags</th><th>authors</th><th>updated</th></tr>"
        + "".join(rows) + "</table>"))
    print(f"collab-wiki: wrote {len(ps) + 1} files to {out}")


def main():
    ap = argparse.ArgumentParser(prog="collab-wiki")
    sub = ap.add_subparsers(dest="cmd", required=True)

    # --no-pull on the read-side verbs, after the verb (same feel as collab-view).
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--no-pull", action="store_true",
                        help="render what's local, skip git pull")

    sub.add_parser("list", parents=[common], help="list pages").set_defaults(fn=cmd_list)

    r = sub.add_parser("read", parents=[common], help="render one page")
    r.add_argument("page")
    r.add_argument("--raw", action="store_true", help="bodies only, no attribution headers")
    r.set_defaults(fn=cmd_read)

    w = sub.add_parser("write", help="append your own fragment (or rewrite your digest)")
    w.add_argument("page")
    w.add_argument("--msg", default="")
    w.add_argument("--file", default="")
    w.add_argument("--title", default="")
    w.add_argument("--ref", default="", help="related run/recipe id")
    w.add_argument("--summary", action="store_true", help="write/overwrite MY digest for this page")
    w.set_defaults(fn=cmd_write)

    s = sub.add_parser("search", parents=[common], help="grep page bodies + titles")
    s.add_argument("term")
    s.set_defaults(fn=cmd_search)

    h = sub.add_parser("html", parents=[common], help="render a static site for humans")
    h.add_argument("outdir")
    h.set_defaults(fn=cmd_html)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
