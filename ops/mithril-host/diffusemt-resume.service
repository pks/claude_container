[Unit]
Description=Resume diffusemt agent at boot (Mithril preempt-recovery)
After=network-online.target docker.service home-ubuntu-exp.mount
# Deliberately soft (Wants=, not Requires=/RequiresMountsFor=). On a Mithril
# relocation the exp volume attaches asynchronously — the by-label device unit
# can time out (~90s default) and fail home-ubuntu-exp.mount's first job, even
# though the disk appears seconds later and the mount then succeeds. A hard
# dep on the mount would mark this oneshot "dependency failed" — and Type=oneshot
# has no Restart, so it NEVER fires again, leaving the GPU idle until manual
# rescue (observed 2026-07-31 and 2026-08-04). Wants=+After= only orders us
# after the mount *attempt*; resume.sh then waits for the mount and docker to
# actually come up before launching, so a late attach is recovered, not fatal.
#
# CRITICAL: do NOT set WorkingDirectory= (or any *Directory=/*Paths=) under
# /home/ubuntu/exp — systemd auto-injects an implicit RequiresMountsFor= for
# such paths, a HARD Requires+After on the mount that silently defeats the soft
# Wants= above (this is exactly what bit the v1 hardening). For the same reason
# ExecStart points at a copy of resume.sh in /usr/local/bin (OFF the mount), so
# the unit can start and run its wait-loop before the volume is even attached.
Wants=network-online.target docker.service home-ubuntu-exp.mount

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
# PROFILE/GPU left unset: run.sh resolves them from $STATE_DIR/.config on
# resume. Pin them via /home/ubuntu/exp/.diffusemt-resume.env if needed.
Environment=TMUX_SESSION=diffusemt
EnvironmentFile=-/home/ubuntu/exp/.diffusemt-resume.env
ExecStart=/usr/local/bin/diffusemt-resume.sh
ExecStop=/usr/bin/tmux kill-session -t ${TMUX_SESSION}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
