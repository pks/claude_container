{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "BashOutput",
      "KillShell",
      "SlashCommand",
      "WebFetch",
      "WebSearch"
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/mithril-hook.sh"
          }
        ]
      }
    ]
  }
}
