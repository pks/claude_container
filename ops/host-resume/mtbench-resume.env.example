# /etc/mtbench-resume.env — host specifics for bench-resume.service.
# Copy to /etc/mtbench-resume.env and edit. All optional (defaults shown).

# Where the bench repo (this claude_container, bench branch) is cloned.
REPO=/home/ubuntu/mtbench

# Durable run state — MUST live on a volume that survives preemption. Holds the
# agent workspace, checkpoints, the compute clock (.bench_elapsed_s) and the
# completion marker (.bench_done). Defaults to $REPO/state.
STATE_DIR=/home/ubuntu/mtbench/state

# Mount point of the durable volume (bench-resume.sh waits for it). If STATE_DIR
# is a plain directory (no separate volume), leave MOUNT = STATE_DIR.
MOUNT=/home/ubuntu/mtbench/state

# Bench image + run profile.
IMAGE=mtbench-container
PROFILE=pi-azure
GPU=all

# Egress allowlist: the agent's inference endpoint host(s), comma-separated.
# If unset, bench-egress.sh derives it from AZURE_BASE_URL in the repo .env.
# INFERENCE_ALLOWLIST=lilt-research-resource.services.ai.azure.com

# Compute budget in seconds (default 43200 = 12h of ACTIVE time; preemption
# gaps do not count).
# BENCH_BUDGET_S=43200
